[Unit]
Description=MineFleet 360 GPS signal-loss sweep (opens SIGNAL_LOST alerts, SYSTEM actor)
Documentation=file:/opt/minefleet/docs/GPS_ALERTS.md
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# La commande s'exécute dans un conteneur éphémère de l'image API (rôle applicatif mf_app, jamais le propriétaire).
# Adapter le répertoire et les fichiers compose au déploiement réel avant activation.
WorkingDirectory=/opt/minefleet/infra/deploy
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm --no-deps api minefleet sweep-gps-signal
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=240
