[Unit]
Description=MineFleet 360 GPS signal-loss sweep (opens SIGNAL_LOST alerts, SYSTEM actor)
Documentation=file:/opt/minefleet/docs/GPS_ALERTS.md
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
# La commande s'exécute dans un conteneur éphémère de l'image API (rôle applicatif mf_app, jamais le propriétaire).
# Adapter le répertoire et les fichiers compose au déploiement réel avant activation.
WorkingDirectory=/opt/minefleet/infra/deploy
# Image API lue dans le reçu de release (jamais minefleet-api:local, jamais de build) — voir run-scheduled-job.sh.
ExecStart=/usr/bin/bash /opt/minefleet/infra/deploy/run-scheduled-job.sh sweep-gps-signal
# Marqueur de réussite (ExecStartPost ne s'exécute que si ExecStart a réussi) : survit au redémarrage,
# contrairement à ExecMainExitTimestamp ; lu par probe-scheduled-jobs.sh (constat staging ST-11).
StateDirectory=minefleet-jobs
StateDirectoryMode=0755
ExecStartPost=/usr/bin/touch /var/lib/minefleet-jobs/%N.success
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=240
