# Copy to /etc/minefleet/monitor.env, chmod 0600, owner root.
# Staging example only. NEVER commit real SMTP secrets.
MINEFLEET_BASE_URL=https://staging.example.invalid
MF_BACKUP_MAX_AGE_HOURS=26
# Absolute path to the archives produced by backup.sh; grant monitor read/traverse only.
MF_BACKUP_DIR=/opt/minefleet/infra/deploy/backups
# Scheduled jobs checked by probe-scheduled-jobs.sh (systemd units without .service, optional ":max hours"):
# list only the timers actually enabled on this server, otherwise the probe reports UNKNOWN.
MF_SCHEDULED_UNITS="minefleet-hse-digest minefleet-preventive-evaluate minefleet-gps-signal-sweep:1"
MF_SCHEDULED_MAX_AGE_HOURS=26
MF_ALERT_SMTP_HOST=smtp.example.invalid
MF_ALERT_SMTP_PORT=587
MF_ALERT_SMTP_USERNAME=replace
MF_ALERT_SMTP_PASSWORD=replace
MF_ALERT_EMAIL_FROM=monitor@example.invalid
MF_ALERT_EMAIL_TO=operations@example.invalid
MF_ALERT_INSTANCE=minefleet-staging
