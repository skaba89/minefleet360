# Copie des sauvegardes hors du serveur (D-41, C-09). Copier en offsite.env (droits 600) pour l'activer.
# Destination : un « remote » rclone configuré par l'exploitant (`rclone config`), au choix :
#   OVH Object Storage (S3)  → ovh-s3:minefleet-sauvegardes
#   autre stockage S3        → s3-coffre:mon-bucket/minefleet
#   serveur SFTP             → sftp-coffre:/sauvegardes/minefleet
MF_OFFSITE_REMOTE=
# Fichier contenant la phrase de chiffrement (droits 600, HORS du dépôt, à conserver aussi dans un coffre) :
#   head -c 48 /dev/urandom | base64 > ~/.minefleet-offsite-passphrase && chmod 600 ~/.minefleet-offsite-passphrase
MF_OFFSITE_PASSPHRASE_FILE=
# Rétention distante en jours (défaut 30).
MF_OFFSITE_RETENTION_DAYS=30
