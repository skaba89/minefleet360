# Copier en .env.prod SUR LE SERVEUR (jamais commité, droits 600) ; remplacer chaque valeur.
# staging = recette avec données fictives ; production = données réelles (après levée des bloquants).
MF_ENV=staging
# Générer les secrets avec : openssl rand -hex 32
MF_DOMAIN=minefleet.exemple-a-remplacer.com
MF_ACME_EMAIL=exploitation@exemple-a-remplacer.com
POSTGRES_PASSWORD=
MF_OWNER_PASSWORD=
MF_APP_PASSWORD=
MF_JWT_SECRET=
MF_ALLOWED_ORIGINS=
# Pairs autorisés à transmettre X-Forwarded-For (IP/CIDR du proxy). Sans proxy de confiance : 127.0.0.1.
MF_FORWARDED_ALLOW_IPS=
# SMTP requis en production. Capture réservée aux données fictives de recette/développement.
MF_MAIL_BACKEND=capture
MF_MAIL_CAPTURE_TTL_SECONDS=86400
MF_PUBLIC_WEB_URL=https://minefleet.exemple-a-remplacer.com
MF_SMTP_HOST=
MF_SMTP_PORT=587
MF_SMTP_USERNAME=
MF_SMTP_PASSWORD=
MF_SMTP_SENDER=
MF_SMTP_USE_SSL=false
MF_SMTP_TIMEOUT_SECONDS=10
