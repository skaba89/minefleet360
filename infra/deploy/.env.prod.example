# Copier en .env.prod SUR LE SERVEUR (jamais commité, droits 600) ; remplacer chaque valeur.
# staging = recette avec données fictives ; production = données réelles (après levée des bloquants).
MF_ENV=staging
# Générer les secrets avec : openssl rand -hex 32
MF_DOMAIN=minefleet.exemple-a-remplacer.com
MF_ACME_EMAIL=exploitation@exemple-a-remplacer.com
POSTGRES_PASSWORD=
MF_OWNER_PASSWORD=
MF_APP_PASSWORD=
MF_JWT_SECRET=
MF_ALLOWED_ORIGINS=
# Pairs autorisés à transmettre X-Forwarded-For (IP/CIDR du proxy). Sans proxy de confiance : 127.0.0.1.
MF_FORWARDED_ALLOW_IPS=
# SMTP requis en production. Capture réservée aux données fictives de recette/développement.
MF_MAIL_BACKEND=capture
MF_MAIL_CAPTURE_TTL_SECONDS=86400
MF_PUBLIC_WEB_URL=https://minefleet.exemple-a-remplacer.com
MF_SMTP_HOST=
MF_SMTP_PORT=587
MF_SMTP_USERNAME=
MF_SMTP_PASSWORD=
MF_SMTP_SENDER=
MF_SMTP_USE_SSL=false
MF_SMTP_TIMEOUT_SECONDS=10

# Double authentification (C-03) : clé AES-256 en base64url, générée sur le serveur :
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# À SAUVEGARDER hors serveur (coffre) : sans elle, aucun second facteur ne se vérifie plus.
MF_MFA_ENCRYPTION_KEY=
# enroll (défaut) : rôles sensibles contraints à l'enrôlement ; off : jamais en production.
MF_MFA_ENFORCEMENT=enroll
# Statut de sécurité d'un véhicule ou conducteur affecté (D-41) : flag (défaut), block ou close.
MF_ASSIGNMENT_SAFETY_POLICY=flag

# Scanner documentaire ClamAV interne : activer seulement après santé et signatures vérifiées.
MF_LEGAL_MALWARE_SCAN_ENABLED=false
MF_LEGAL_MALWARE_SCAN_HOST=
MF_LEGAL_MALWARE_SCAN_PORT=3310
MF_LEGAL_MALWARE_SCAN_TIMEOUT=10

# Stockage privé PDF (S3/MinIO) — désactivé avant recette réelle.
# Endpoint HTTPS uniquement, bucket privé, identifiants à privilèges minimaux.
# Ne jamais commiter les vraies clés d'accès ni publier le bucket.
MF_LEGAL_OBJECT_STORAGE_ENABLED=false
MF_LEGAL_OBJECT_STORAGE_ENDPOINT=
MF_LEGAL_OBJECT_STORAGE_BUCKET=
MF_LEGAL_OBJECT_STORAGE_ACCESS_KEY=
MF_LEGAL_OBJECT_STORAGE_SECRET_KEY=
