# Copier en .env (jamais commité) — scripts/dev-up.ps1 le génère avec des valeurs aléatoires.
MF_ENV=local
POSTGRES_PASSWORD=__a_generer__
MF_OWNER_PASSWORD=__a_generer__
MF_APP_PASSWORD=__a_generer__
MF_JWT_SECRET=__a_generer_64_caracteres_min__
MF_DB_NAME=minefleet
MF_COOKIE_SECURE=false
MF_ALLOWED_ORIGINS=http://localhost:5173
MF_MAIL_CAPTURE_DIR=/app/var/mail

# Double authentification (C-03). Recette/production : MF_MFA_ENCRYPTION_KEY obligatoire (32 octets base64url,
# ex. python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())").
# MF_MFA_ENFORCEMENT=enroll (défaut) impose l'enrôlement aux rôles sensibles ; off en développement local.
MF_MFA_ENFORCEMENT=off
