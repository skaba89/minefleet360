# Service des fichiers statiques de l'interface (derrière le proxy HTTPS, qui route /api vers l'API).
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip
	header {
		# Aucune ressource tierce : scripts, styles et appels réseau limités à l'origine (anti-XSS).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
	# Fichiers versionnés par Vite : cache long ; le reste (index.html) toujours revalidé.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"
	# Routes de l'application (/affectations, /activation…) servies par index.html ; un fichier
	# /assets/ absent reste un 404 (sinon une erreur de déploiement passerait inaperçue).
	@spa {
		not path /assets/*
		not file
	}
	rewrite @spa /index.html
	file_server
}
